# Public application URL used for Stripe return URLs
NEXT_PUBLIC_APP_URL=https://ohi.demo.pluginpip.uk

# Persistent single-node commerce store path.
# Keep this outside the deployment release directory in production so releases do not overwrite it.
OHI_COMMERCE_STORE_PATH=/var/lib/ohi/commerce-store.json

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Xero OAuth 2.0
XERO_CLIENT_ID=replace_me
XERO_CLIENT_SECRET=replace_me
XERO_REFRESH_TOKEN=replace_me
XERO_TENANT_ID=replace_me
XERO_SALES_ACCOUNT_CODE=200
# DRAFT keeps invoice orders pending finance. AUTHORIZED makes approved account orders operational immediately.
XERO_INVOICE_STATUS=DRAFT
